// A Postilla syntax highlighting theme.
// Every field is optional except `name`; colors are "#rrggbb" or "#rrggbbaa".
(
    name: "Example Postilla Theme",
    // Editor / code block colors
    background: "#1e1e2e",
    foreground: "#cdd6f4",
    selection: "#45475a",
    caret: "#f5e0dc",
    // Code
    comment: "#6c7086",
    keyword: "#cba6f7",
    string: "#a6e3a1",
    number: "#fab387",
    constant: "#fab387",
    function: "#89b4fa",
    type: "#f9e2af",
    variable: "#f38ba8",
    operator: "#94e2d5",
    punctuation: "#9399b2",
    tag: "#89b4fa",
    attribute: "#f9e2af",
    inserted: "#a6e3a1",
    deleted: "#f38ba8",
    // Markdown
    heading: "#89b4fa",
    strong: "#fab387",
    emphasis: "#f9e2af",
    link: "#74c7ec",
    quote: "#a6adc8",
    list: "#f5c2e7",
    code: "#a6e3a1",
    // Optional raw syntect/TextMate scope overrides
    scopes: {
        "entity.name.function.macro": "#f5c2e7",
    },
)
