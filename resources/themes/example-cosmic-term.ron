// A COSMIC Terminal color scheme, exactly as exported by COSMIC Terminal.
(
    name: "Example COSMIC Term Scheme",
    foreground: "#cdd6f4",
    background: "#1e1e2e",
    cursor: "#f5e0dc",
    bright_foreground: "#cdd6f4",
    dim_foreground: "#6c7086",
    normal: (
        black: "#45475a",
        red: "#f38ba8",
        green: "#a6e3a1",
        yellow: "#f9e2af",
        blue: "#89b4fa",
        magenta: "#f5c2e7",
        cyan: "#94e2d5",
        white: "#bac2de",
    ),
    bright: (
        black: "#585b70",
        red: "#f38ba8",
        green: "#a6e3a1",
        yellow: "#f9e2af",
        blue: "#89b4fa",
        magenta: "#f5c2e7",
        cyan: "#94e2d5",
        white: "#a6adc8",
    ),
)
